<?xml version="1.0" encoding="utf-8"?>
<SharedDataSet xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/shareddatasetdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSet Name="DataSet1">
    <Query>
      <DataSourceReference>DataSource1</DataSourceReference>
      <CommandText>SELECT        VClienteSolicitudGeneral.*
FROM            VClienteSolicitudGeneral</CommandText>
    </Query>
    <Fields>
      <Field Name="CodVenta">
        <DataField>CodVenta</DataField>
        <rd:TypeName>System.Int64</rd:TypeName>
      </Field>
      <Field Name="CodCliente">
        <DataField>CodCliente</DataField>
        <rd:TypeName>System.Int64</rd:TypeName>
      </Field>
      <Field Name="NombreCliente">
        <DataField>NombreCliente</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="CédulaIdentidad">
        <DataField>CédulaIdentidad</DataField>
        <rd:TypeName>System.Int64</rd:TypeName>
      </Field>
      <Field Name="FechaSolicitud">
        <DataField>FechaSolicitud</DataField>
        <rd:TypeName>System.DateTime</rd:TypeName>
      </Field>
      <Field Name="Estado">
        <DataField>Estado</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="TipoSolicitud">
        <DataField>TipoSolicitud</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="TipoPago">
        <DataField>TipoPago</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="Usuario">
        <DataField>Usuario</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="SubTotal">
        <DataField>SubTotal</DataField>
        <rd:TypeName>System.Double</rd:TypeName>
      </Field>
      <Field Name="MontoDescuento">
        <DataField>MontoDescuento</DataField>
        <rd:TypeName>System.Double</rd:TypeName>
      </Field>
      <Field Name="MontoTotal">
        <DataField>MontoTotal</DataField>
        <rd:TypeName>System.Double</rd:TypeName>
      </Field>
    </Fields>
  </DataSet>
</SharedDataSet>